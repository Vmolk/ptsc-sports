# ============================================================
# QAQC Sport Tournament — Environment variables
# Copy to ".env" for local dev.
# Production: Netlify > Site settings > Environment variables
# ============================================================

# ---- Frontend (exposed to browser) ----
VITE_API_BASE_URL=/api
VITE_EVENT_DATE=2026-07-01T08:00:00+07:00

# ---- Auth (server-only) ----
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=qaqc2026

# ---- Google Sheets (for live data editing) ----
# 1. Create a Google Sheet with tabs: event, sports, teams, matches, medals, gallery, athletes
# 2. File → Share → Publish to web (select "Entire document" → CSV)
# 3. Copy the Sheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here
