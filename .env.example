# ============================================================
# Environment variables — copy to ".env" for local dev.
# In production: Netlify > Site settings > Environment variables.
#
# VITE_* variables are exposed to the browser bundle.
# All other variables are server-only (Netlify Functions).
# ============================================================

# ---- Frontend ----
VITE_API_BASE_URL=/api
VITE_EVENT_DATE=2026-07-01T08:00:00+07:00

# ---- Auth (server-only) ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=qaqc2026

# ---- Supabase (required for CRUD features) ----
# Get these from: https://supabase.com > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Supabase Storage (image upload) ----
# Run this SQL in Supabase to create the storage bucket:
#   INSERT INTO storage.buckets (id, name, public) VALUES ('images', 'images', true);
